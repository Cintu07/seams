#!/bin/sh
# git external diff driver: GIT_EXTERNAL_DIFF=seams-git git diff
# git passes: path old-file old-hex old-mode new-file new-hex new-mode
[ $# -eq 7 ] || { echo "seams-git: expected 7 arguments from git" >&2; exit 2; }
printf 'diff --git a/%s b/%s\n' "$1" "$1"
seams --color -L "a/$1" -L "b/$1" "$2" "$5"
[ $? -le 1 ]
