{
  "manifest_version": 3,
  "name": "seams for GitHub",
  "version": "0.2.0",
  "description": "Opens any GitHub pull request in seams: every file diffed in your browser, comments synced with GitHub.",
  "content_scripts": [{ "matches": ["https://github.com/*/*/pull/*"], "js": ["button.js"], "run_at": "document_idle" }],
  "options_page": "options.html",
  "permissions": ["storage"],
  "host_permissions": ["https://api.github.com/*", "https://raw.githubusercontent.com/*", "https://codeload.github.com/*"],
  "content_security_policy": { "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'" },
  "web_accessible_resources": []
}
